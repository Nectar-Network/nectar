# ── Keeper operator keypairs ──────────────────────────────────────────────────
# Primary keeper secret key (used by keeper-alpha)
KEEPER_SECRET=SABC...

# Two-keeper docker-compose mode
KEEPER_A_SECRET=SABC...
KEEPER_B_SECRET=SABC...

# Display name for this keeper instance
KEEPER_NAME=keeper-alpha

# ── Deployed contract addresses ───────────────────────────────────────────────
# Run ./scripts/testnet-setup.sh to populate these automatically
USDC_CONTRACT=CXXX...        # deployed mock USDC token
REGISTRY_CONTRACT=CXXX...   # KeeperRegistry contract
VAULT_CONTRACT=CYYY...       # NectarVault contract

# Blend pools to monitor for liquidations. Comma-separated `ADDRESS[:mode]`
# entries; mode is `active` (default — vault capital may fill this pool's
# auctions) or `monitor` (scan + report only, no capital). Example:
#   BLEND_POOLS=CCEB...HGF:monitor,CXYZ...ABC:active
# Known testnet pools (source: docs/FACTS.md, verified 2026-08-03):
#   - Blend TestnetV2 (official): CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
#     (settles Blend-mock USDC, NOT our vault's Circle USDC — run as :monitor
#     unless a conversion route is verified; see FACTS.md Decisions)
# Leave empty — keeper runs in vault-monitor-only mode (API still serves,
# no liquidation cycle).
BLEND_POOLS=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF:monitor

# Legacy single-pool variable, still honored when BLEND_POOLS is unset
# (active mode). Prefer BLEND_POOLS.
#BLEND_POOL=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF

# ── Borrower discovery ────────────────────────────────────────────────────────
# The keeper discovers borrowers ITSELF by replaying pool events; there is no
# address list to maintain. On a cold start it backfills the RPC's whole
# retention window (observed: 120960 ledgers ≈ 7 days), then reads only what is
# new each cycle.
#
# BORROWER_CACHE persists {pool -> last_ledger, borrower set} so a restart
# resumes instead of re-backfilling. It is an OPTIMISATION ONLY — a cold start
# with no cache reaches exactly the same set, just slower. Empty (the default)
# disables persistence; point it at a path on a mounted volume to enable it,
# otherwise a redeploy throws the file away anyway.
#BORROWER_CACHE=/app/state/borrowers.json

# Optional ADDITIVE override: addresses probed every cycle whether or not any
# event ever named them. This is a supplement to event discovery, not the
# mechanism — leaving it empty is the normal case.
#WATCH_ADDRESSES=GXXX...,GYYY...

# ── DEX (collateral → USDC conversion after auction fills) ────────────────────
# Soroswap is the primary venue, Phoenix the fallback. Leave a router empty to
# disable that venue. With no DEX configured the keeper holds non-USDC collateral
# rather than synthesizing proceeds.
# Soroswap router (testnet, verified from soroswap/core public/testnet.contracts.json):
SOROSWAP_ROUTER=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
# Phoenix has no public testnet deployment; set to an XYK pool (pair) contract
# for the collateral/USDC pair if available, else leave empty.
# PHOENIX_ROUTER=CXXX...
# Max swap slippage in basis points (100 = 1%, default 100, range 0–10000)
# SLIPPAGE_BPS=100

# ── DeFindex (multi-protocol adapter — vault rebalancing) ─────────────────────
# When set, the keeper monitors a DeFindex vault and rebalances it toward target
# weights when allocation drifts. Rebalancing moves the DeFindex vault's OWN
# funds (no Nectar capital). The keeper's address must be assigned the vault's
# RebalanceManager (or Manager) role on-chain, or rebalances are skipped.
# Example testnet USDC vault (paltalabs/defindex public/testnet.contracts.json):
# DEFINDEX_VAULT=CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN
# Allocation drift threshold in basis points (500 = 5%, default 500, range 0–10000)
# DEFINDEX_DRIFT_BPS=500

# ── Network config (defaults to Soroban Testnet) ──────────────────────────────
# SOROBAN_RPC=https://soroban-testnet.stellar.org:443
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# HORIZON_URL=https://horizon-testnet.stellar.org

# ── Tuning ────────────────────────────────────────────────────────────────────
# POLL_INTERVAL=10        # seconds between keeper cycles (min 3, max 300)
# MIN_PROFIT=1.02         # minimum lot/bid ratio to fill (must be > 0)
# BAD_DEBT_MAX_SPEND=1000000000   # keeper-FLOAT USDC cap (stroops) per bad-debt fill; 0 disables.
#                                 # Bad-debt fills never draw vault capital: the backstop-LP lot
#                                 # is held (fill-and-hold), so the spend is operator risk.
# BAD_DEBT_LP_HAIRCUT_BPS=5000    # discount on the backstop LP spot valuation (5000 = 50%)

# ── Deploy scripts ────────────────────────────────────────────────────────────
# ADMIN_SECRET=SABC...    # Stellar secret for deploying contracts
# ADMIN_ADDRESS=GABC...   # Corresponding public key

# ── Frontend (frontend/.env.local) ────────────────────────────────────────────
# All four are referenced in frontend/lib/stellar.ts and frontend/app/vault/.
# After ./scripts/tranche-1-e2e.sh, copy the IDs from .env into these.
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_REGISTRY_CONTRACT=CXXX...
# NEXT_PUBLIC_VAULT_CONTRACT=CYYY...
# NEXT_PUBLIC_USDC_CONTRACT=CZZZ...

# ── Performance page (comma-separated list of depositor addresses) ─────────────
# KNOWN_DEPOSITORS=GABC...,GDEF...,GHIJ...
# USER_01_ADDRESS=GABC...
# USER_02_ADDRESS=GDEF...
# ... (15 users generated by scripts/gen-wallets.sh)
# USER_15_ADDRESS=GXYZ...
